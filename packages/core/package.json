{
  "name": "@svelte-motion/core",
  "version": "0.3.0",
  "keywords": [
    "svelte"
  ],
  "homepage": "https://github.com/Michael-Obele/svelte-motion#readme",
  "bugs": {
    "url": "https://github.com/Michael-Obele/svelte-motion/issues"
  },
  "license": "MIT",
  "author": "Michael-Obele",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michael-Obele/svelte-motion.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && vp run prepack",
    "preview": "vp preview",
    "test": "vp test",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.1.3",
    "publint": "^0.3.21",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
