{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023", "dom"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["bun"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@svelte-motion/renderer": ["../../packages/renderer/src/index.ts"]
    }
  },
  "include": [
    "determinism.ts",
    "render-demo.ts",
    "verify-determinism.ts",
    "verify-player-parity.ts"
  ]
}
