{
  "name": "svelte-motion",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp run -r build && bun run check && vp run -r test && bun run tools/spike/verify-determinism.ts",
    "dev": "vp run core#build && vp run examples#dev",
    "dev:studio": "vp run studio#dev",
    "dev:web": "vp run web#dev",
    "dev:examples": "vp run core#build && vp run examples#dev",
    "build:examples": "vp run -t examples#build",
    "check:examples": "vp run examples#check",
    "changeset": "changeset",
    "changeset:auto": "bun run tools/release/version-from-commits.ts",
    "check": "vp check && vp run -r check",
    "version-packages": "changeset version && vp fmt",
    "spike": "vp run studio#build && bun run tools/spike/determinism.ts",
    "render-demo": "bun run tools/spike/render-demo.ts",
    "test:e2e": "vp run renderer#test:e2e",
    "test:e2e:cli": "vp run cli#test:e2e",
    "verify": "vp run studio#build && bun run tools/spike/verify-determinism.ts",
    "verify:player": "vp run studio#build && bun run tools/spike/verify-player-parity.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.4",
    "svelte": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "svelte": "^5.57.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  }
}
